<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UsePublishedPackage Condition="'$(UsePublishedPackage)' == ''">true</UsePublishedPackage>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePublishedPackage)' == 'false'">
    <ProjectReference Include="../../Bimo.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../examples/HelloBimo/HelloBimo.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedPackage)' == 'true'">
    <PackageReference Include="Bimo.Tools" Version="[1.3.0]" />
  </ItemGroup>
</Project>
